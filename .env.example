# ==============================================================================
# ANGEL AI — ENVIRONMENT SPECIFICATION & SECRETS GUIDE
# ==============================================================================
# Copy this file to .env or configure these variables in your deployment platform
# (e.g., Vercel Project Settings, Cloud Run, GitHub Actions, or local .env).
#
# IMPORTANT SECURITY DIRECTIVE:
# - NEVER commit real keys or credentials to version control.
# - SUPABASE_SERVICE_ROLE_KEY, GITHUB_TOKEN, and VERCEL_TOKEN are SERVER-ONLY secrets.
# ==============================================================================

# --- 1. Core Server & Runtime ---
# PORT: Local and container listening port (default: 3000)
PORT=3000
# NODE_ENV: 'development' or 'production'
NODE_ENV=development
# APP_URL: The canonical public base URL where this application is hosted
APP_URL="http://localhost:3000"

# --- 2. AI Intelligence Providers ---
# GEMINI_API_KEY: Required for Gemini 3.8 Flash, multimodal vision, tool planning, and streaming
GEMINI_API_KEY=""

# OPENAI_API_KEY: Optional secondary provider for OpenAI GPT models
OPENAI_API_KEY=""

# --- 3. Supabase Cloud Persistence (PostgreSQL & Vector Store) ---
# SUPABASE_URL: Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=""
# SUPABASE_ANON_KEY: Client-safe public anonymous API key
SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY: Server-only administrative key with elevated privileges (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=""

# --- 4. GitHub Synchronization & Automated Commits ---
# GITHUB_TOKEN: Personal Access Token (PAT) with repo scope for automated commits & task sync
GITHUB_TOKEN=""
# GITHUB_REPO_OWNER: GitHub organization or username (e.g. 'octocat')
GITHUB_REPO_OWNER=""
# GITHUB_REPO_NAME: Target repository name (e.g. 'angel-ai-workspace')
GITHUB_REPO_NAME=""

# --- 5. Vercel Deployment & Continuous Deployment ---
# VERCEL_PROJECT_ID: Found in Vercel Project Settings > General
VERCEL_PROJECT_ID=""
# VERCEL_ORG_ID: Found in Vercel Team/Account Settings
VERCEL_ORG_ID=""
# VERCEL_TOKEN: Vercel Personal Access Token for CLI and automated deployments
VERCEL_TOKEN=""

# --- 6. Automation, Webhooks & Event Triggers (Zapier / Make / n8n / Custom) ---
# OUTBOUND_WEBHOOK_URL: Destination URL for Angel workspace event dispatches
# (Triggers on: task.created, task.completed, agent.executed, message.received, memory.created, memory.updated, workflow.completed)
OUTBOUND_WEBHOOK_URL=""
# WEBHOOK_SECRET: Shared secret token used to sign outbound payloads (HMAC SHA-256) and authenticate inbound webhooks
WEBHOOK_SECRET=""

# Legacy alias compatibility for Zapier:
ZAPIER_OUTBOUND_WEBHOOK_URL=""
ZAPIER_WEBHOOK_SECRET=""
