# ==============================================================================
# ANGEL AI — ENVIRONMENT SPECIFICATION & SECRETS GUIDE
# ==============================================================================
# Copy this file to .env or configure these variables in your deployment platform
# (e.g., Netlify Project environment settings, a container service, or local .env).
#
# IMPORTANT SECURITY DIRECTIVE:
# - NEVER commit real keys or credentials to version control.
# - SUPABASE_SERVICE_ROLE_KEY, GITHUB_TOKEN, and VERCEL_TOKEN are SERVER-ONLY secrets.
# ==============================================================================

# --- 1. Core Server & Runtime ---
# PORT: Local and container listening port (default: 3000)
PORT=3000
# NODE_ENV: 'development' or 'production'
NODE_ENV=development
# APP_URL: The canonical public base URL where this application is hosted
APP_URL="http://localhost:3000"

# --- 2. AI Intelligence Providers ---
# GEMINI_API_KEY: Required for Gemini 3.8 Flash, multimodal vision, tool planning, and streaming
GEMINI_API_KEY=""

# OPENAI_API_KEY: Optional secondary provider for OpenAI GPT models
OPENAI_API_KEY=""

# --- 3. Tencent Hy-MT2 translation model (server only) ---
# Base URL for a hosted OpenAI-compatible chat-completions endpoint serving Hy-MT2.
# Do not point this at the model repository URL. Netlify must call an inference service.
HYMT2_API_BASE_URL=""
# Server-side endpoint token. HF_TOKEN is also accepted for a Hugging Face router endpoint.
HYMT2_API_KEY=""
# Default to the smallest Hy-MT2 family model; set to a server's served model name if required.
HYMT2_MODEL_ID="tencent/Hy-MT2-1.8B"

# --- 3. Qwen Image 2.1 (hosted image generation/editing) ---
# Model Studio workspace base URL, for example:
# https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# The workspace/URL and API key must belong to the same region.
QWEN_IMAGE_API_BASE_URL=""
QWEN_IMAGE_API_KEY=""
QWEN_IMAGE_MODEL_ID="qwen-image-2.1-turbo"

# --- 4. External Python and Google ADK runtimes (server-only) ---
# Exact HTTPS endpoint for a separately deployed isolated code sandbox.
# The service must disable network access and enforce CPU/memory/time/output limits.
ANGEL_PYTHON_RUN_URL=""
ANGEL_PYTHON_RUN_TOKEN=""
# Exact HTTPS POST endpoint for python/adk_service/main.py, such as https://<service>/run
ANGEL_ADK_RUN_URL=""
# Must match ANGEL_ADK_SERVICE_TOKEN configured on the external ADK service.
ANGEL_ADK_API_KEY=""
ANGEL_ADK_APP_NAME="angel-adk-bridge"
# External ADK runtime configuration (set in the Python service, not in Netlify):
# ANGEL_ADK_DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/<database>"
# ANGEL_ADK_MCP_SERVER_URL="https://angel-ai-new.netlify.app/api/mcp"
# ANGEL_ADK_SERVICE_TOKEN=""

# --- 5. Optional external GPU inference runtime ---
# This is only a status/connection reference. GPU inference/optimization does not run inside Netlify.
ANGEL_GPU_INFERENCE_BASE_URL=""
ANGEL_MCP_ENABLED="true"
# Optional comma-separated browser Origins permitted to call Angel's MCP endpoint.
ANGEL_MCP_ALLOWED_ORIGINS=""

# --- 6. Supabase Cloud Persistence (PostgreSQL & Vector Store) ---
# Browser-safe Vite variables. These are public by design and are protected by Supabase RLS.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Server-side Supabase variables.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY is server-only. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- 4. GitHub Synchronization & Automated Commits ---
# GITHUB_TOKEN: Personal Access Token (PAT) with repo scope for automated commits & task sync
GITHUB_TOKEN=""
# GITHUB_REPO_OWNER: GitHub organization or username (e.g. 'octocat')
GITHUB_REPO_OWNER=""
# GITHUB_REPO_NAME: Target repository name (e.g. 'angel-ai-workspace')
GITHUB_REPO_NAME=""

# --- 5. Optional Vercel API integration (not Angel's hosting platform) ---
# VERCEL_PROJECT_ID: Found in Vercel Project Settings > General
VERCEL_PROJECT_ID=""
# VERCEL_ORG_ID: Found in Vercel Team/Account Settings
VERCEL_ORG_ID=""
# VERCEL_TOKEN: Optional server-only token for using Angel's Vercel integration API.
VERCEL_TOKEN=""

# --- 6. Automation, Webhooks & Event Triggers (Zapier / Make / n8n / Custom) ---
# OUTBOUND_WEBHOOK_URL: Destination URL for Angel workspace event dispatches
# (Triggers on: task.created, task.completed, agent.executed, message.received, memory.created, memory.updated, workflow.completed)
OUTBOUND_WEBHOOK_URL=""
# WEBHOOK_SECRET: Shared secret token used to sign outbound payloads (HMAC SHA-256) and authenticate inbound webhooks
WEBHOOK_SECRET=""

# Legacy alias compatibility for Zapier:
ZAPIER_OUTBOUND_WEBHOOK_URL=""
ZAPIER_WEBHOOK_SECRET=""
